{
  "name": "mcp-gatehouse",
  "version": "0.1.0",
  "description": "A guard for any MCP server: tool allow/deny rules, secret redaction in both directions, prompt-injection and tool-poisoning checks, rug-pull pinning, and a JSONL audit log. Runs locally, no account, no telemetry.",
  "license": "MIT",
  "author": "James Son",
  "type": "module",
  "bin": {
    "mcp-gatehouse": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-security",
    "mcp-proxy",
    "mcp-gateway",
    "guardrails",
    "prompt-injection",
    "tool-poisoning",
    "secret-scanning",
    "audit-log",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/detect.test.mjs test/gate.test.mjs"
  }
}
